# === Base de données (PostgreSQL) ===
POSTGRES_USER=desdispos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=desdispos

# URL utilisée par l'API / Prisma (hôte "db" = nom du service docker-compose)
DATABASE_URL=postgresql://desdispos:changeme@db:5432/desdispos?schema=public

# === API (NestJS) ===
API_PORT=3000
# Interface d'écoute des ports publiés (api, web). 127.0.0.1 = poste seul. Pour tester sur un vrai
# téléphone du réseau local : BIND_HOST=0.0.0.0 (et ajouter l'IP LAN à WEB_ORIGIN ci-dessous).
BIND_HOST=127.0.0.1
# Origines autorisées (CORS), séparées par des virgules.
# Pour tester sur un vrai téléphone du réseau local, ajouter l'IP LAN du poste :
#   WEB_ORIGIN=http://localhost:4200,http://192.168.1.x:4200
# En production : ne garder QUE l'origine publique réelle (cf. docs/backlog.md § Palier 11).
WEB_ORIGIN=http://localhost:4200

# === Auth / session ===
SESSION_SECRET=dev-secret-change-me-please
# Premier compte admin (créé par le seed)
ADMIN_EMAIL=admin@desdispos.local
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=change-me-admin

# === Web (Angular) ===
WEB_PORT=4200
API_URL=http://localhost:3000

# === E-mail (SMTP) ===
# Dev/test : Mailpit (service docker-compose, aucun e-mail ne quitte réellement la machine).
# Prod : mêmes clés pointant vers Brevo (host/port/user/password fournis par Brevo) — aucun changement de code.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Dés Dispos <no-reply@desdispos.local>"
