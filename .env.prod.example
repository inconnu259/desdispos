# Modèle de configuration de PRODUCTION — à copier en `.env.prod` (jamais versionné) puis remplir.
# Aucune valeur ici n'est utilisable telle quelle : l'API refuse de démarrer avec les valeurs de .env.dev.
#
# Générer chaque secret sur le Pi, par exemple :
#   openssl rand -base64 48        (SESSION_SECRET)
#   openssl rand -base64 24        (mots de passe)

# === Base de données ===
POSTGRES_USER=desdispos
POSTGRES_PASSWORD=
POSTGRES_DB=desdispos
# Même mot de passe que POSTGRES_PASSWORD (encodé URL s'il contient des caractères spéciaux).
DATABASE_URL=postgresql://desdispos:<POSTGRES_PASSWORD>@db:5432/desdispos?schema=public

# === API ===
# Origine publique du site, en https, UNE seule valeur (le front et l'API partagent cette origine).
WEB_ORIGIN=https://exemple.fr
# Au moins 32 caractères aléatoires.
SESSION_SECRET=

# Compte admin initial, créé au premier démarrage seulement (jamais modifié ensuite). Au moins 12 caractères.
ADMIN_EMAIL=
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=

# === E-mail (SMTP, ex. Brevo) ===
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Dés Dispos <no-reply@exemple.fr>"
# STARTTLS exigé (défaut en production). Ne mettre `false` que pour un relais local de test.
MAIL_REQUIRE_TLS=true

# Le jeton du tunnel Cloudflare ne va PAS ici mais dans `.env.tunnel` (TUNNEL_TOKEN=...), lu par le seul
# conteneur cloudflared — cf. docker-compose.prod.yml.
